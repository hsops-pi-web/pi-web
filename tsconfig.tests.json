{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
